FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV HOST=0.0.0.0
ENV PYTHONUNBUFFERED=1
ENV DATABASE_PATH=/data/resilientedge.db

EXPOSE 8000

CMD sh -c 'uvicorn backend.api.fastapi_app:app --host ${HOST:-0.0.0.0} --port ${PORT:-8000}'
