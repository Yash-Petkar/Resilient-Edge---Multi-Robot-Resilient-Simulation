APP_URL=http://127.0.0.1:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
HOST=127.0.0.1
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=./data/resilientedge.db
# Used only by the initial admin bootstrap command when set.
RESILIENTEDGE_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development

# Judge/demo entry flow: access-mode selection without a password. Backend RBAC remains enforced.
DEMO_MODE=true
VITE_DEMO_MODE=true
